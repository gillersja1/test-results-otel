{
  "title": "CI test results",
  "uid": "test-results-otel",
  "description": "Test results from every repo's CI, sent by gillersja1/test-results-otel.",
  "tags": [
    "ci",
    "tests",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "regex": "/^(?!.*(alert-state-history|usage-insights)).*$/"
      },
      {
        "name": "repo",
        "label": "Repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(test_run_cases, service_name)",
          "refId": "repo-values"
        },
        "definition": "label_values(test_run_cases, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      },
      {
        "name": "branch",
        "label": "Branch",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(test_run_cases, vcs_ref_head_name)",
          "refId": "branch-values"
        },
        "definition": "label_values(test_run_cases, vcs_ref_head_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "main",
            "master"
          ],
          "value": [
            "main",
            "master"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "test-results-otel",
      "type": "link",
      "url": "https://github.com/gillersja1/test-results-otel",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Pass rate (latest runs)",
      "description": "Passed / (passed + failed) across the latest run of every repo and suite. Skipped tests and known-defect suites are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum(last_over_time(test_run_cases{service_namespace=\"ci\", service_name=~\"$repo\", vcs_ref_head_name=~\"$branch\", test_suite_name!~\"known-defects.*|self-test\", test_case_result_status=~\"pass\"}[$__range])) / sum(last_over_time(test_run_cases{service_namespace=\"ci\", service_name=~\"$repo\", vcs_ref_head_name=~\"$branch\", test_suite_name!~\"known-defects.*|self-test\", test_case_result_status=~\"pass|fail\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Failing now",
      "description": "Failed tests in the latest run of every repo and suite (known defects left out).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum(last_over_time(test_run_cases{service_namespace=\"ci\", service_name=~\"$repo\", vcs_ref_head_name=~\"$branch\", test_suite_name!~\"known-defects.*|self-test\", test_case_result_status=~\"fail\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Test executions",
      "description": "Every test result received in the time range, across all runs.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name!~\"known-defects.*|self-test\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Known defects still failing",
      "description": "Tests that assert correct behaviour against bugs in the systems under test. They pass once the bug is fixed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum(last_over_time(test_run_cases{service_namespace=\"ci\", service_name=~\"$repo\", vcs_ref_head_name=~\"$branch\", test_suite_name=~\"known-defects.*\", test_case_result_status=~\"fail\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "bargauge",
      "title": "Pass rate by repo (latest run)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "expr": "sum by (service_name) (last_over_time(test_run_cases{service_namespace=\"ci\", service_name=~\"$repo\", vcs_ref_head_name=~\"$branch\", test_suite_name!~\"known-defects.*|self-test\", test_case_result_status=\"pass\"}[$__range])) / sum by (service_name) (last_over_time(test_run_cases{service_namespace=\"ci\", service_name=~\"$repo\", vcs_ref_head_name=~\"$branch\", test_suite_name!~\"known-defects.*|self-test\", test_case_result_status=~\"pass|fail\"}[$__range]))",
          "legendFormat": "{{service_name}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 10
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Failed tests over time",
      "description": "Failed test results received, per repo (known defects left out).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name!~\"known-defects.*|self-test\" | test_case_result_status=\"fail\" [$__auto]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "No failed tests in this time range"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 14,
        "h": 10
      },
      "id": 6
    },
    {
      "type": "logs",
      "title": "Latest failures",
      "description": "Newest first. Expand a line for the full message and the link to the CI run.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "{service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name!~\"known-defects.*|self-test\" | test_case_result_status=\"fail\" | line_format \"{{.service_name}} · {{.test_suite_name}} · {{.test_case_name}} — {{.test_message}}  ({{.cicd_pipeline_run_url_full}})\" | keep service_name",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "showLabels": false,
        "showCommonLabels": false,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Flaky tests",
      "description": "Tests that both passed and failed in the time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "count by (service_name, test_case_name) (sum by (service_name, test_case_name, test_case_result_status) (count_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name!~\"known-defects.*|self-test\" | test_case_result_status=~\"pass|fail\" [$__range]))) > 1",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "service_name": "Repo",
              "test_case_name": "Test"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No flaky tests in this time range"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Slowest tests",
      "description": "Longest single run of each test in the time range (load tests left out).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "topk(10, max by (service_name, test_case_name) (max_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name!~\"known-defects.*|self-test\" | test_suite_name!=\"load\" | unwrap test_duration_ms [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "Repo",
              "test_case_name": "Test",
              "Value #A": "Slowest (ms)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Slowest (ms)",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Known defects",
      "description": "Each known-defect test's latest result. A pass means the bug in the system under test was fixed.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (service_name, test_suite_name, test_case_name, test_case_result_status) (count_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name=~\"known-defects.*\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "Repo",
              "test_suite_name": "Suite",
              "test_case_name": "Test",
              "test_case_result_status": "Result",
              "Value #A": "Runs"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fail": {
                        "color": "purple",
                        "text": "still failing"
                      },
                      "pass": {
                        "color": "green",
                        "text": "fixed?"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Load test checks",
      "description": "Every k6 check and threshold, and every JMeter sampler, with how many runs it passed or failed in.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (service_name, test_group_name, test_case_name, test_case_result_status) (count_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name=\"load\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service_name": 0,
              "test_group_name": 1,
              "test_case_name": 2,
              "test_case_result_status": 3,
              "Value #A": 4
            },
            "renameByName": {
              "service_name": "Repo",
              "test_group_name": "Group",
              "test_case_name": "Check",
              "test_case_result_status": "Result",
              "Value #A": "Runs"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Result"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No load test runs in this time range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fail": {
                        "color": "red",
                        "text": "failed"
                      },
                      "pass": {
                        "color": "green",
                        "text": "passed"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Repo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Load test response times (JMeter)",
      "description": "p95 and average response time per sampler, one point per run.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "max by (test_case_name) (max_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name=\"load\" | unwrap jmeter_p95_ms | __error__=\"\" [$__auto]))",
          "legendFormat": "{{test_case_name}} p95",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "B",
          "expr": "max by (test_case_name) (max_over_time({service_namespace=\"ci\", service_name=~\"$repo\"} | vcs_ref_head_name=~\"$branch\" | test_suite_name=\"load\" | unwrap jmeter_avg_ms | __error__=\"\" [$__auto]))",
          "legendFormat": "{{test_case_name}} avg",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No JMeter runs in this time range",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
